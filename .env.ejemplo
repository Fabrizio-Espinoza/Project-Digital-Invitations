# Copia este archivo como ".env" EN EL SERVIDOR y llena los valores.
# El .env nunca se sube a git (está en .gitignore): ahí viven los secretos.

# Llave secreta NUEVA (la de settings.py ya es pública). Genérala con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Dominios desde los que se abre el sitio, separados por coma (sin https://)
DJANGO_ALLOWED_HOSTS=www.tudominio.mx,tudominio.mx

# Ruta del admin: algo que no sea "admin" (ej. panel-7k2q). Sin diagonales.
DJANGO_ADMIN_URL=panel-cambia-esto

# Cabecera con la IP real del invitado (para el límite anti-spam).
# PythonAnywhere: HTTP_X_REAL_IP. Servidor propio sin balanceador: REMOTE_ADDR.
DJANGO_CABECERA_IP=HTTP_X_REAL_IP

# 1 solo si tu hosting manda X-Forwarded-Proto (no hace falta en PythonAnywhere:
# ahí se usa el interruptor "Force HTTPS" de la pestaña Web).
DJANGO_PROXY_HTTPS=0

# Aviso de privacidad (/privacidad/): quién es responsable de los datos
MARCA_NOMBRE=Tu Marca
AVISO_RESPONSABLE=Nombre completo o razón social
AVISO_DOMICILIO=Calle, número, colonia, ciudad, estado, C.P.
AVISO_CORREO=privacidad@tudominio.mx
